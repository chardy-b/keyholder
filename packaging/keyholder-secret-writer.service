[Unit]
Description=Keyholder isolated secret writer (opt-in)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=keyholder-secret-writer
Group=keyholder-secret-writer
SupplementaryGroups=keyholder-clients
RuntimeDirectory=keyholder-secret-writer
RuntimeDirectoryMode=0755
LogsDirectory=keyholder-secret-writer
LogsDirectoryMode=0750
UMask=0077
ExecStart=/usr/local/bin/keyholderd --secret-writer-only --config /etc/keyholder-secret-writer/policy.yaml --socket /run/keyholder-secret-writer/keyholder.sock --socket-group keyholder-clients
LoadCredentialEncrypted=bws-create-access-token:/etc/keyholder-secret-writer/bws-create-access-token.cred
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/keyholder-secret-writer /run/keyholder-secret-writer
InaccessiblePaths=-/etc/keyholder -/var/lib/keyholder -/var/log/keyholder
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
LimitCORE=0

[Install]
WantedBy=multi-user.target
